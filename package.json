{
  "name": "zalupmen",
  "version": "1.0.0",
  "description": "ZalupMen Messenger",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "build": "electron-builder"
  },
  "author": "Muzonov",
  "license": "ISC",
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10"
  },
  "build": {
    "appId": "com.zalupmen.app",
    "productName": "ZalupMen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json",
      "server/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "ZalupMen-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}